{
  "global": {
    "files": "/src/**/*.*"
  },
  "dependencies": [
    {
      "url": "https://github.com/abapedia/steampunk-2305-api-intersect-702",
      "folder": "/deps",
      "files": "/src/**/*.*"
    },
    {
      "url": "https://github.com/abap2UI5/abap2UI5",
      "folder": "/abap2UI5",
      "files": "/src/**/*.*"
    },
    // the libraries the samples show, one entry per package in src/
    {
      "url": "https://github.com/zenrosadira/abap-tbox-stats",
      "folder": "/tbox-stats",
      "files": "/src/**/*.*"
    },
    {
      "url": "https://github.com/fidley/JSON2ABAPType",
      "folder": "/json2abaptype",
      "files": "/src/**/*.*"
    },
    {
      "url": "https://github.com/hhelibeb/abap-data-validator",
      "folder": "/data-validator",
      "files": "/src/**/*.*"
    },
    {
      "url": "https://github.com/abap2xlsx/abap2xlsx",
      "folder": "/abap2xlsx",
      "files": "/src/**/*.*"
    },
    {
      "url": "https://github.com/cesar-sap/abap_fm_json",
      "folder": "/abap_fm_json",
      "files": "/src/**/*.*"
    },
    {
      "url": "https://github.com/abap-openapi/abap-openapi",
      "folder": "/abap-openapi",
      "files": "/src/**/*.*"
    },
    {
      "url": "https://github.com/abapPM/ABAP-Diff3",
      "folder": "/diff3",
      "files": "/src/**/*.*"
    },
    {
      "url": "https://github.com/hhelibeb/abap-fm-logger",
      "folder": "/abap-fm-logger",
      "files": "/src/**/*.*"
    },
    {
      "url": "https://github.com/beraadim/zcl_pdf",
      "folder": "/zcl_pdf",
      "files": "/src/**/*.*"
    },
    {
      "url": "https://github.com/se38/abapFaker",
      "folder": "/abapFaker",
      "files": "/src/**/*.*"
    },
    {
      "url": "https://github.com/AntonSikidin/zcl_docx",
      "folder": "/zcl_docx",
      "files": "/src/**/*.*"
    }
  ],
  "syntax": {
    "version": "v750",
    // Z and Y objects and local names must resolve. The standard types the
    // libraries use that are no released API and so in no dependency stub
    // (tbox-stats: the data element NAME_FELD, IF_FSBP_CONST_RANGE) stay void
    "errorNamespace": "^(Z|Y|LCL_|TY_|LIF_)"
  },
  "rules": {
    "downport": true,
    "begin_end_names": true,
    "check_ddic": true,
    "check_include": true,
    "check_syntax": true,
    "global_class": true,
    "definitions_top": false,
    "implement_methods": true,
    "method_implemented_twice": true,
    "parser_error": true,
    "superclass_final": true,
    "unknown_types": true,
    // the abapGit round trip: a trailing blank or a sidecar without its BOM
    // comes back different on every pull
    "whitespace_end": true,
    "xml_bom": true,
    "xml_consistency": true,
    // the rest of abap2UI5's rule set (abaplint.jsonc of abap2UI5/abap2UI5), with its settings
    "7bit_ascii": true,
    "add_test_attributes": true,
    "aff_and_xml": true,
    "allowed_object_naming": true,
    "ambiguous_statement": true,
    "avoid_use": true,
    "begin_single_include": true,
    "call_transaction_authority_check": true,
    "catch_and_raise": true,
    "cds_association_name": true,
    "cds_field_order": true,
    "cds_parser_error": true,
    "chain_mainly_declarations": true,
    "change_if_to_case": true,
    "check_abstract": true,
    "check_comments": true,
    "check_text_elements": true,
    "check_transformation_exists": true,
    "classic_exceptions_overlap": true,
    "clear_exporting_parameters": true,
    "cloud_types": true,
    "colon_missing_space": true,
    "constant_classes": true,
    "constructor_visibility_public": true,
    "contains_tab": true,
    "cyclic_oo": {
      "exclude": [],
      "skip": [
        "Z2UI5_IF_APP",
        "Z2UI5_IF_CLIENT",
        "Z2UI5_CL_UI5_ACTION",
        "Z2UI5_CL_UI5_HANDLER"
      ],
      "skipSharedMemory": true,
      "skipTestclasses": true
    },
    "dangerous_statement": {
      "deleteDynpro": true,
      "deleteReport": true,
      "deleteTextpool": true,
      "dynamicSQL": true,
      "exclude": [],
      "execSQL": true,
      "exportDynpro": true,
      "generateDynpro": true,
      "generateReport": true,
      "generateSubroutine": true,
      "insertReport": true,
      "insertTextpool": true,
      "kernelCall": true,
      "severity": "Error",
      "systemCall": true
    },
    "db_operation_in_loop": true,
    "description_empty": true,
    "dynpro_checks": true,
    "easy_to_find_messages": true,
    "else_after_all_returns": true,
    "empty_event": true,
    "empty_statement": true,
    "empty_structure": {
      "at": true,
      "case": true,
      "catch": true,
      "do": true,
      "exclude": [],
      "if": true,
      "loop": false,
      "select": true,
      "try": true,
      "when": false,
      "while": true
    },
    "exit_or_check": true,
    "expand_macros": true,
    "exporting": true,
    "fm_global_parameters_obsolete": true,
    "forbidden_identifier": true,
    "forbidden_pseudo_and_pragma": {
      "exclude": [],
      "ignoreGlobalClassDefinition": false,
      "ignoreGlobalInterface": false,
      "pragmas": [],
      "pseudo": [],
      "severity": "Error"
    },
    "forbidden_void_type": {
      "check": [
        "^boole_d$",
        "^char10$",
        "^char12$",
        "^char2$",
        "^char20$",
        "^char30$",
        "^char4$",
        "^char50$",
        "^char70$",
        "^cl_abap_syst",
        "^cl_aff_",
        "^cl_aucv_test_runner_abstract$",
        "^cl_aucv_test_runner_standard$",
        "^cl_aunit_assert$",
        "^cl_axt_dbtable$",
        "^cl_blue_wb_utility$",
        "^cl_oo_source$",
        "^/ui2/cl_",
        "^cl_saunit_internal_result$",
        "^cl_srvd_wb_object_data$",
        "^cl_wb_object_operator_factory$",
        "^cl_wer_const$",
        "^cl_xco_",
        "^cx_aff_",
        "^cx_wb_object_operation_error$",
        "^cx_xco_",
        "^flag$",
        "^i18_a_langiso2$",
        "^if_adt_lock_handle$",
        "^if_aff_",
        "^if_satc_ci_variant_access$",
        "^if_saunit_internal_result$",
        "^if_saunit_internal_result_type$",
        "^if_srvd_types$",
        "^if_wb_adt_plugin_resource_co$",
        "^if_wb_object_data_selection_co$",
        "^if_wb_object_operator$",
        "^if_xco_",
        "^int4$",
        "^numc2$",
        "^sabp_t_tadir_keys$",
        "^sap_bool$",
        "^srcsystem$",
        "^stringtab$",
        "^sychar01$",
        "^sychar10$",
        "^sychar70$",
        "^sydatum$",
        "^sylangu$",
        "^syst_title$",
        "^syuzeit$",
        "^feld$",
        "^abap_boolean$"
      ],
      "exclude": []
    },
    "form_tables_obsolete": true,
    "fully_type_constants": {
      "checkData": true,
      "exclude": []
    },
    "fully_type_itabs": true,
    "function_module_recommendations": true,
    "functional_writing": {
      "exclude": [],
      "ignoreExceptions": true
    },
    "identical_conditions": true,
    "identical_contents": true,
    "identical_descriptions": true,
    "identical_form_names": true,
    "identical_move": true,
    "if_in_if": true,
    "implicit_start_of_selection": true,
    "index_completely_contained": true,
    "inline_data_old_versions": true,
    "intf_referencing_clas": {
      "allow": [
        "^cl_abap_"
      ],
      "exclude": []
    },
    "invalid_table_index": true,
    "line_break_style": true,
    "local_testclass_consistency": true,
    "macro_naming": true,
    "main_file_contents": true,
    "many_parentheses": true,
    "max_one_method_parameter_per_line": true,
    "max_one_statement": true,
    "message_exists": true,
    "method_overwrites_builtin": true,
    "mix_returning": true,
    "modify_only_own_db_tables": {
      "exclude": [],
      "ownTables": "^[yz]",
      "reportDynamic": true
    },
    "msag_consistency": true,
    "names_no_dash": true,
    "nesting": {
      "depth": 5,
      "exclude": []
    },
    "newline_between_methods": true,
    "no_aliases": true,
    "no_chained_assignment": true,
    "no_comments_between_methods": true,
    "no_external_form_calls": true,
    "nrob_consistency": true,
    "obsolete_statement": true,
    "omit_preceding_zeros": true,
    "omit_receiving": true,
    "parser_702_chaining": true,
    "parser_bad_exceptions": true,
    "parser_missing_space": true,
    "pragma_style": true,
    "prefer_abap_bool": true,
    "prefer_abap_bool_values": true,
    "prefer_is_not": true,
    "prefer_pragmas": true,
    "prefer_raise_exception_new": true,
    "prefer_returning_to_exporting": true,
    "prefer_xsdbool": true,
    "preferred_compare_operator": true,
    "preferred_parameter_ignored": true,
    "prefix_is_current_class": {
      "exclude": [],
      "severity": "Warning"
    },
    "reduce_procedural_code": true,
    "reduce_string_templates": true,
    "redundant_conversion": true,
    "release_idoc": true,
    "remove_descriptions": {
      "exclude": [],
      "ignoreExceptions": false,
      "ignoreWorkflow": false,
      "severity": "Error"
    },
    "rfc_error_handling": true,
    "select_add_order_by": true,
    "select_single_full_key": true,
    "selection_screen_naming": true,
    "sequential_blank": {
      "exclude": [],
      "severity": "Warning"
    },
    "short_case": true,
    "sicf_consistency": true,
    "slow_parameter_passing": true,
    "sql_escape_host_variables": true,
    "sql_value_conversion": true,
    "static_call_via_instance": {
      "allowInTestclassIncludes": false,
      "exclude": []
    },
    "strict_sql": true,
    "superfluous_value": true,
    "sy_modification": true,
    "tabl_enhancement_category": true,
    "tables_declared_locally": true,
    "try_without_catch": true,
    "type_form_parameters": true,
    "uncaught_exception": true,
    "unnecessary_chaining": true,
    "unnecessary_loop_guard": true,
    "unnecessary_pragma": true,
    "unnecessary_return": true,
    "unreachable_code": true,
    "unsecure_fae": true,
    "unused_ddic": true,
    "unused_macros": true,
    "unused_methods": true,
    "unused_types": true,
    "unused_variables": {
      "exclude": [],
      "severity": "Error",
      "skipNames": [
        "lv_dummy",
        "lv_dummy2",
        "lv_dummy3",
        "lv_dummy4",
        "<dummy>"
      ]
    },
    "use_bool_expression": true,
    "use_class_based_exceptions": true,
    "use_line_exists": true,
    "use_message_class": true,
    "use_new": true,
    "when_others_last": true,
    "wrong_abapdoc_position": true
  }
}
